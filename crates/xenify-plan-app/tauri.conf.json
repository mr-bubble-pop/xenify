{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xenify Plan",
  "mainBinaryName": "xenify-plan",
  "identifier": "app.xenify.plan",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Xenify",
    "copyright": "MIT licence",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Tasks, Gantt charts and who is busy",
    "longDescription": "Plan work with boards, lists and Gantt charts. Link tasks, give them to people, groups and things at a share of their time, and move everything after a late task when you want to. Edit together on a Xenify server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "xplan"
        ],
        "name": "Xenify Plan plan",
        "description": "Xenify Plan plan",
        "role": "Editor",
        "mimeType": "application/x-xenify-plan"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0"
        ],
        "section": "office",
        "desktopTemplate": "packaging/linux.desktop.hbs"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsoup3"
        ],
        "desktopTemplate": "packaging/linux.desktop.hbs"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {}
    }
  }
}